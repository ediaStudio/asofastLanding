<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{TITLE}} - AsoFast</title>
  <meta name="description" content="{{DESCRIPTION}}">
  <link rel="canonical" href="{{SITE_URL}}/blog/{{SLUG}}/">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="stylesheet" href="/assets/css/syntax.css">
  <meta property="og:title" content="{{TITLE}} - AsoFast">
  <meta property="og:description" content="{{DESCRIPTION}}">
  <meta property="og:url" content="{{SITE_URL}}/blog/{{SLUG}}/">
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{DATE}}">
  {{JSON_LD}}
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo" aria-label="AsoFast home">
        <img src="/assets/logo.svg" alt="" width="32" height="32">
        AsoFast
      </a>
      <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true">
      <label for="menu-toggle" class="burger" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </label>
      <nav class="nav-links">
        <a href="/#features">Features</a>
        <a href="/#how-it-works">How it works</a>

        <a href="/blog/">Blog</a>
        <a href="{{REPO_URL}}" class="btn btn-primary" target="_blank" rel="noopener">Get started</a>
      </nav>
    </div>
  </header>

  <main class="blog-post">
    <div class="container">
      <article>
        <header>
          <h1>{{TITLE}}</h1>
          <p class="meta">Published on <time datetime="{{DATE}}">{{DATE}}</time></p>
        </header>
        <div class="content">
          {{CONTENT}}
        </div>
        <a href="/blog/" class="back-link">&larr; Back to the blog</a>
      </article>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <a href="/" class="logo">
        <img src="/assets/logo.svg" alt="" width="32" height="32">
        AsoFast
      </a>
      <ul class="footer-links">
        <li><a href="/#features">Features</a></li>

        <li><a href="/blog/">Blog</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="{{REPO_URL}}" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
      <div class="footer-meta">
        <p>&copy; {{YEAR}} AsoFast. Contact: <a href="mailto:{{EMAIL}}">{{EMAIL}}</a>.</p>
      </div>
    </div>
  </footer>
</body>
</html>
