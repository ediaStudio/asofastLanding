<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Blog - AsoFast</title>
  <meta name="description" content="Guides and practical notes on App Store and Google Play optimization, localization, screenshots, and keyword research.">
  <link rel="canonical" href="{{SITE_URL}}/blog/">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "AsoFast Blog",
    "url": "{{SITE_URL}}/blog/"
  }
  </script>
  <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "2e085f1ce62f4197ba56aee2c20412a3"}'></script><!-- End Cloudflare Web Analytics -->
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo" aria-label="AsoFast home">
        <img src="/assets/logo.svg" alt="" width="32" height="32">
        AsoFast
      </a>
      <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true">
      <label for="menu-toggle" class="burger" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </label>
      <nav class="nav-links">
        <a href="/#features">Features</a>
        <a href="/#how-it-works">How it works</a>
        
        <a href="/blog/">Blog</a>
        <a href="{{REPO_URL}}" class="btn btn-primary" target="_blank" rel="noopener">Get started</a>
      </nav>
    </div>
  </header>

  <main class="blog-list">
    <div class="container">
      <h1 class="section-title">AsoFast blog</h1>
      <p class="section-lead">Practical guides for App Store and Google Play optimization, written for developers who want to own their listings.</p>
      <div class="blog-grid">
        {{POSTS}}
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <a href="/" class="logo">
        <img src="/assets/logo.svg" alt="" width="32" height="32">
        AsoFast
      </a>
      <ul class="footer-links">
        <li><a href="/#features">Features</a></li>
        <li></li>

        <li><a href="/blog/">Blog</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="{{REPO_URL}}" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
      <div class="footer-meta">
        <p>&copy; {{YEAR}} AsoFast. Contact: <a href="mailto:{{EMAIL}}">{{EMAIL}}</a>.</p>
      </div>
    </div>
  </footer>
</body>
</html>
